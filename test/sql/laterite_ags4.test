# Integration tests for the laterite_ags4 extension.
# Run via: make test   (extension-ci-tools drives DuckDB's sqllogictest runner)
#
# Format: https://duckdb.org/dev/sqllogictest/intro.html
#   query I = INTEGER result, query T = VARCHAR, query R = REAL/DOUBLE.
# Expected output must match DuckDB's exact format (LESSONS.md Pitfall P5) —
# verify with `make test` before submitting; the fixture path is relative to the
# repo root (the test runner's CWD).

require laterite_ags4

# read_ags: LOCA has 2 rows.
query I
SELECT count(*) FROM read_ags('test/sql/mini.ags', 'LOCA');
----
2

# Born-typed: a 2DP heading is DOUBLE, an ID heading is VARCHAR.
query T
SELECT typeof(loca_gl) FROM read_ags('test/sql/mini.ags', 'LOCA') LIMIT 1;
----
DOUBLE

query T
SELECT typeof(loca_id) FROM read_ags('test/sql/mini.ags', 'LOCA') LIMIT 1;
----
VARCHAR

# Born-typed value: the string "100.50" arrives as the double 100.5.
query I
SELECT (loca_gl = 100.5)::INTEGER FROM read_ags('test/sql/mini.ags', 'LOCA') WHERE loca_id = 'BH01';
----
1

# Deterministic keys: every SAMP row joins to its LOCA via _parent_id = _id,
# across two independent read_ags calls, with zero orphans.
query I
SELECT count(*) FROM read_ags('test/sql/mini.ags', 'SAMP') s
JOIN read_ags('test/sql/mini.ags', 'LOCA') l ON s._parent_id = l._id;
----
3

query I
SELECT count(*) FROM read_ags('test/sql/mini.ags', 'SAMP') s
LEFT JOIN read_ags('test/sql/mini.ags', 'LOCA') l ON s._parent_id = l._id
WHERE l._id IS NULL;
----
0

# _content_hash (#448): the row's VALUE fingerprint — the value twin of `_id`'s
# identity, always emitted (trailing). Byte-identical to the wheel / Node / browser
# (one shared keychain leaf), so these literals — the wheel's own output for
# mini.ags — ARE the cross-surface parity proof.
query T
SELECT _content_hash FROM read_ags('test/sql/mini.ags', 'LOCA') WHERE loca_id = 'BH01';
----
22dd55fd-2ac8-8d07-8220-25cd62ce47fd

query T
SELECT _content_hash FROM read_ags('test/sql/mini.ags', 'LOCA') WHERE loca_id = 'BH02';
----
089b7a54-d873-88e2-842d-3bbb17ded1c8

# Distinct row values → distinct hashes.
query I
SELECT (count(DISTINCT _content_hash) = count(*))::INTEGER FROM read_ags('test/sql/mini.ags', 'LOCA');
----
1

# Value-dedup: DISTINCT ON (_content_hash) collapses genuinely-identical rows. LOCA
# UNION'd with itself is 4 rows / 2 distinct values → 2 survive.
query I
SELECT count(*)::INTEGER FROM (
  SELECT DISTINCT ON (_content_hash) * FROM (
    SELECT * FROM read_ags('test/sql/mini.ags', 'LOCA')
    UNION ALL
    SELECT * FROM read_ags('test/sql/mini.ags', 'LOCA')
  )
);
----
2

# Metadata: 3 groups; LOCA's parent is PROJ.
query I
SELECT count(*) FROM ags_groups('test/sql/mini.ags');
----
3

query T
SELECT parent FROM ags_groups('test/sql/mini.ags') WHERE "group" = 'LOCA';
----
PROJ

# ags_relationships: SAMP's parent is LOCA, sharing LOCA_ID.
query T
SELECT parent FROM ags_relationships() WHERE child = 'SAMP';
----
LOCA

# --- ags_rules() — the numbered rule catalogue as rows (#294 F#11) ---------
query I
SELECT count(*) FROM ags_rules();
----
27

# Rule 8 (numeric reformat) is an error-severity, fixable rule.
query I
SELECT count(*) FROM ags_rules() WHERE rule = '8' AND severity = 'error' AND fixable;
----
1

# Every rule has a title; severities are from the known set.
query I
SELECT count(*) FROM ags_rules() WHERE title IS NULL OR severity NOT IN ('error', 'warning', 'fyi', 'mixed');
----
0

# --- ags_dictionary(edition) — one edition's STANDARD dictionary (#294 F#6) -
# The schema grew across editions: 4.0.3 has fewer groups than 4.2.
query I
SELECT count(DISTINCT "group") FROM ags_dictionary(edition := '4.0.3');
----
124

query I
SELECT count(DISTINCT "group") FROM ags_dictionary(edition := '4.2');
----
171

# PROJ_ID is the KEY of PROJ in that edition (same 9-column shape as the union).
query I
SELECT count(*) FROM ags_dictionary(edition := '4.2')
WHERE "group" = 'PROJ' AND heading = 'PROJ_ID' AND status = 'KEY+REQUIRED' AND sql_type = 'VARCHAR';
----
1

# No argument = the union registry (default) — spans all editions, so ≥ any one.
query I
SELECT count(DISTINCT "group") FROM ags_dictionary();
----
174

# An unknown edition is a bind-time error.
statement error
SELECT * FROM ags_dictionary(edition := '9.9');
----
unknown edition

# read_ags_text: parse AGS4 content passed as a VARCHAR (stable-API path, no VFS).
# Same born-typed output as read_ags — 2 LOCA rows, LOCA_GL typed DOUBLE — but the
# content comes in as an argument (here a literal; a bound parameter at runtime),
# so it needs no virtual filesystem. chr(10) joins avoid blank lines in this file.
query IT
SELECT count(*)::INTEGER, MAX(typeof(loca_gl)) FROM read_ags_text(
'"GROUP","PROJ"' || chr(10) || '"HEADING","PROJ_ID"' || chr(10) ||
'"UNIT",""' || chr(10) || '"TYPE","ID"' || chr(10) || '"DATA","P1"' || chr(10) ||
chr(10) ||
'"GROUP","LOCA"' || chr(10) || '"HEADING","LOCA_ID","LOCA_GL"' || chr(10) ||
'"UNIT","","m"' || chr(10) || '"TYPE","ID","2DP"' || chr(10) ||
'"DATA","BH01","55.20"' || chr(10) || '"DATA","BH02","48.30"', 'LOCA');
----
2	DOUBLE

# --- parse cache (P1) -----------------------------------------------------
# The cache is transparent: every read_ags / ags_groups / load_ags call in
# this file re-resolves the same path, so the whole suite already exercises cache
# hits after the first parse. These pin the behaviour the cache is meant to keep
# correct while making it a single parse.

# Three separate reads of one file in one statement — each is its own read_parsed
# call (first parses, the rest hit the cache) — still return the right per-group
# row counts.
query III
SELECT
  (SELECT count(*) FROM read_ags('test/sql/mini.ags', 'PROJ')),
  (SELECT count(*) FROM read_ags('test/sql/mini.ags', 'LOCA')),
  (SELECT count(*) FROM read_ags('test/sql/mini.ags', 'SAMP'));
----
1	2	3

# load_ags: 8 statements for mini.ags — PROJ (table + _id index) is root
# so has no _parent_id index; LOCA and SAMP each add one (3 stmts each). Executing
# the script runs one read_ags per group, all served by a single cached parse.
query I
SELECT count(*) FROM load_ags('test/sql/mini.ags');
----
8

# The first generated statement is the PROJ table CTAS (file order); its body is
# the now-cache-backed read_ags.
query T
SELECT stmt FROM load_ags('test/sql/mini.ags') WHERE seq = 0;
----
CREATE TABLE ags_proj AS SELECT * FROM read_ags('test/sql/mini.ags', 'PROJ');

# to_duckdb: load_ags's shape (8 stmts) wrapped to persist to a NAMED file — an
# ATTACH bookend at seq 0 and a DETACH at the end → 10 statements. Tables are
# created INTO the attached db (_lat_out.ags_<g>).
query I
SELECT count(*) FROM to_duckdb('test/sql/mini.ags', 'out.duckdb');
----
10

# seq 0 ATTACHes the destination…
query T
SELECT stmt FROM to_duckdb('test/sql/mini.ags', 'out.duckdb') WHERE seq = 0;
----
ATTACH 'out.duckdb' AS _lat_out;

# …the first CTAS (PROJ, file order) targets the attached db…
query T
SELECT stmt FROM to_duckdb('test/sql/mini.ags', 'out.duckdb') WHERE seq = 1;
----
CREATE TABLE _lat_out.ags_proj AS SELECT * FROM read_ags('test/sql/mini.ags', 'PROJ');

# …and the final statement DETACHes it, flushing a standalone .duckdb.
query T
SELECT stmt FROM to_duckdb('test/sql/mini.ags', 'out.duckdb') WHERE seq = 9;
----
DETACH _lat_out;

# ---- File-declared (custom) groups: the Rule 18 effective dictionary ----
# custom.ags declares bespoke group XMON in its own DICT (KEY PROJ_ID+XMON_ID,
# a 2DP depth, parent PROJ); the engine-minted cert beside it carries
# `defines`. Since the engine owns file-declared identity (#41,
# niko86/laterite#815) an admitted custom group also MINTS: `defines` still
# denies with zero reads, but an admit costs one ranged DICT read — the KEY
# tuple lives in the declarations, not the field. Three byte-identical twins
# pin the three admit routes, and because they are byte-identical their minted
# ids must agree:
#   custom.ags        cert with `defines`      (deny free; admit reads DICT)
#   custom_v2.ags     cert without `defines`   (one ranged read of DICT answers)
#   custom_nocert.ags no cert                  (the whole-file parse answers)

# The cert fast-path binds the custom group.
query I
SELECT count(*) FROM read_ags('test/sql/custom.ags', 'XMON');
----
2

# Born-typed from the file's own TYPE row — the dictionary that typed this
# column is the file's DICT, not the standard one.
query T
SELECT typeof(xmon_dpth) FROM read_ags('test/sql/custom.ags', 'XMON') LIMIT 1;
----
DOUBLE

query I
SELECT (xmon_dpth = 12.5)::INTEGER FROM read_ags('test/sql/custom.ags', 'XMON') WHERE xmon_id = 'M1';
----
1

# Minted from the file's OWN declared KEY tuple (PROJ_ID + XMON_ID), through
# the engine's `group_row_ids_effective` — the exact values the wheel mints for
# this file, pinned so a cross-surface identity drift goes red here.
query TT
SELECT _id, _parent_id FROM read_ags('test/sql/custom.ags', 'XMON') ORDER BY xmon_id;
----
9fdea4c6-93a8-8239-9920-ba882a3623fd	ac30a95d-e0ca-85f9-83c8-37a64af2762b
66ea7835-3ed4-8d2d-a384-d765ac36eb35	ac30a95d-e0ca-85f9-83c8-37a64af2762b

# The declared DICT_PGRP parent chain joins for real: XMON's _parent_id IS the
# PROJ row's _id — the cross-boundary join a standard child gets, on a group
# the standard dictionary has never heard of.
query I
SELECT count(*) FROM read_ags('test/sql/custom.ags', 'XMON') x
JOIN read_ags('test/sql/custom.ags', 'PROJ') p ON x._parent_id = p._id;
----
2

# …but `_content_hash` needs no dictionary at all: the value fingerprint is
# minted from the file's own UNIT/TYPE rows, custom group or not.
query I
SELECT count(DISTINCT _content_hash) FROM read_ags('test/sql/custom.ags', 'XMON');
----
2

# A pre-`defines` cert answers the admit question by range-reading its
# single-span DICT — same rows, same typing, same minted ids.
query I
SELECT count(*) FROM read_ags('test/sql/custom_v2.ags', 'XMON');
----
2

query T
SELECT typeof(xmon_dpth) FROM read_ags('test/sql/custom_v2.ags', 'XMON') LIMIT 1;
----
DOUBLE

query T
SELECT _id FROM read_ags('test/sql/custom_v2.ags', 'XMON') ORDER BY xmon_id LIMIT 1;
----
9fdea4c6-93a8-8239-9920-ba882a3623fd

# No cert: the whole-file parse builds the same effective dictionary and mints
# the same ids.
query I
SELECT count(*) FROM read_ags('test/sql/custom_nocert.ags', 'XMON');
----
2

query T
SELECT _id FROM read_ags('test/sql/custom_nocert.ags', 'XMON') ORDER BY xmon_id LIMIT 1;
----
9fdea4c6-93a8-8239-9920-ba882a3623fd

# A standard group in the same certified file still binds keyed.
query I
SELECT count(*) FROM read_ags('test/sql/custom.ags', 'PROJ') WHERE _id IS NOT NULL;
----
1

# Inline text reads the same union (a table function takes no subquery, so
# the AGS text rides an E'' literal) — and mints: one declared KEY, no parent,
# so distinct _id per row and NULL _parent_id.
query II
SELECT count(DISTINCT _id), count(_parent_id) FROM read_ags_text(E'"GROUP","DICT"\r\n"HEADING","DICT_TYPE","DICT_GRP","DICT_HDNG","DICT_STAT","DICT_DTYP","DICT_UNIT","DICT_PGRP"\r\n"UNIT","","","","","","",""\r\n"TYPE","X","X","X","X","X","X","X"\r\n"DATA","GROUP","XMON","","","","",""\r\n"DATA","HEADING","XMON","XMON_ID","KEY","ID","",""\r\n\r\n"GROUP","XMON"\r\n"HEADING","XMON_ID"\r\n"UNIT",""\r\n"TYPE","ID"\r\n"DATA","M1"\r\n"DATA","M2"\r\n', 'XMON');
----
2	0

# A declaration with no KEY headings stays unkeyed — an empty key tuple would
# stamp every row identically, so the engine's answer is the unkeyed batch and
# the id columns hold NULLs (the schema keeps them).
query I
SELECT count(*) FROM read_ags_text(E'"GROUP","DICT"\r\n"HEADING","DICT_TYPE","DICT_GRP","DICT_HDNG","DICT_STAT","DICT_DTYP","DICT_UNIT","DICT_PGRP"\r\n"UNIT","","","","","","",""\r\n"TYPE","X","X","X","X","X","X","X"\r\n"DATA","GROUP","XNOT","","","","",""\r\n"DATA","HEADING","XNOT","XNOT_DESC","OTHER","X","",""\r\n\r\n"GROUP","XNOT"\r\n"HEADING","XNOT_DESC"\r\n"UNIT",""\r\n"TYPE","X"\r\n"DATA","first note"\r\n"DATA","second note"\r\n', 'XNOT') WHERE _id IS NULL AND _parent_id IS NULL;
----
2

# A group declared by NEITHER side of the effective dictionary is still
# refused — reading it would silently paper over what Rule 18 exists to catch.
statement error
SELECT * FROM read_ags('test/sql/custom_nocert.ags', 'ZZZZ');
----
not found

# Present in the file but declared nowhere cannot happen in a clean fixture
# (the validator would refuse to certify it), so the refusal message is pinned
# through inline text carrying a declared-nowhere group.
statement error
SELECT * FROM read_ags_text(E'"GROUP","ZZZZ"\r\n"HEADING","ZZZZ_ID"\r\n"UNIT",""\r\n"TYPE","ID"\r\n"DATA","1"\r\n', 'ZZZZ');
----
the file's own DICT group does not declare it

# ---- ags_groups / ags_headings honour the file's DICT declarations ----
# The refusal fix bound XMON; these two used to keep reading the registry
# alone, reporting the declared parent as NULL and the declared KEY headings
# as OTHER — the same wrong-source premise, one surface over.

# The declared parent (DICT_PGRP) — not NULL.
query T
SELECT parent FROM ags_groups('test/sql/custom.ags') WHERE "group" = 'XMON';
----
PROJ

# The declared statuses (DICT_STAT): the KEY tuple is PROJ_ID + XMON_ID —
# the same source the validator builds its Rule 10a tuple from.
query TTI
SELECT heading, status, is_key::INTEGER
FROM ags_headings('test/sql/custom.ags')
WHERE "group" = 'XMON' ORDER BY ordinal;
----
PROJ_ID	KEY	1
XMON_ID	KEY	1
XMON_DPTH	OTHER	0
XMON_DESC	OTHER	0

# Registry-first precedence untouched: a standard group's statuses still come
# from the registry (PROJ has exactly its one spec KEY heading).
query I
SELECT count(*) FROM ags_headings('test/sql/mini.ags') WHERE is_key AND "group" = 'PROJ';
----
1
